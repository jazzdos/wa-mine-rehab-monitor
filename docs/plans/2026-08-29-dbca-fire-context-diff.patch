+                            "docs/decisions/2026-08-29-dbca-mirror-declined.md"
+                        )
+                    },
+                    indent=2,
+                    sort_keys=True,
+                )
+            )
+        else:
+            typer.echo(
+                json.dumps(
+                    {
+                        "refusal": (
+                            f"--mode {mode!r} is not recognised -- valid modes are "
+                            "'authoritative' or 'mirror'"
+                        )
+                    },
+                    indent=2,
+                    sort_keys=True,
+                )
+            )
+        raise typer.Exit(1) from None
+
+    if not source_dir.is_dir():
